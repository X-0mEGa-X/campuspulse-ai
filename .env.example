GOOGLE_CLOUD_PROJECT=campuspulse-512111
GOOGLE_CLOUD_LOCATION=global
AGENT_ENGINE_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional for local Gemini Developer API mode. Never commit a real key.
GEMINI_API_KEY=
# Use mtls only if the standard Google endpoint resets connections in your network.
GEMINI_API_ENDPOINT=standard
# Fill after deployment. No API key is needed for Vertex AI with ADC.
AGENT_ENGINE_RESOURCE=
STAGING_BUCKET=
# Optional read-only GitHub token, local/server environment only.
GITHUB_TOKEN=
